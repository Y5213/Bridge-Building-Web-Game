{
  "name": "spancraft-monorepo",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "check": "npm run check:types && npm run test",
    "check:types": "tsc --build",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:shared": "vitest run --dir packages/shared",
    "test:api": "vitest run --dir apps/api",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@spancraft/api",
    "dev:web": "npm run dev --workspace=@spancraft/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
